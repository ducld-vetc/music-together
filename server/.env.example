# Each person pastes their own Spotify Client ID in the browser.
# The proxy speaks PKCE and does not use a shared client id or client secret.
# Register this exact Redirect URI on that person's Spotify app.
# Local dev goes through the Vite proxy, so Spotify should send the browser back to the frontend origin.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/auth/callback

# Where to send the browser after login. No trailing path beyond the app root.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Random string used to sign the login and session cookies. Example: openssl rand -hex 32
SESSION_SECRET=

PORT=8787
# Stay on localhost unless a reverse proxy or remote host should reach this process.
HOST=127.0.0.1

# Lax is enough: Spotify sends the browser back to this API, then the API hands the session to the site.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
